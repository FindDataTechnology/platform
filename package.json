{
  "type": "module",
  "name": "platform",
  "version": "1.3.3",
  "description": "Platform - browser-based AI assistant built on the DeepSeek Harness (dsh) runtime",
  "main": "electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "gateway": "node gateway/index.js",
    "start:electron": "electron .",
    "predist": "node scripts/fetch-build-icon.js && node scripts/build-node.js && node scripts/verify-bundle.js",
    "dist": "npm run web:build && node node_modules/electron-builder/cli.js --publish never",
    "clean:bundle": "rm -rf resources/node",
    "test:e2e": "playwright test --project=fast",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:live": "PW_LIVE=1 playwright test --project=live",
    "test:e2e:live:smoke": "PW_LIVE=1 LIVE_SMOKE=1 playwright test --project=live",
    "test:unit": "node --test --test-concurrency=1 scripts/test-*.mjs",
    "dsh:contracts": "node scripts/dsh-contracts.mjs",
    "check:locales": "node scripts/check-locales.js",
    "lint": "biome check .",
    "typecheck": "npm --prefix web run typecheck",
    "web:install": "npm --prefix web install",
    "web:build": "npm run check:locales && npm --prefix web run build",
    "web:build:e2e": "npm run check:locales && npm --prefix web run build:e2e",
    "web:dev": "npm --prefix web run dev",
    "miniapp:install": "npm --prefix miniapp install",
    "miniapp:build": "npm --prefix miniapp run build:weapp",
    "miniapp:typecheck": "npm --prefix miniapp run typecheck",
    "postinstall": "node scripts/postinstall-web.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sdk-client": "^0.0.1-rc.1",
    "@llamaindex/readers": "latest",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.2",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "js-yaml": "^4.3.2",
    "multer": "^2.2.0",
    "node-schedule": "^2.1.1",
    "officeparser": "^7.5.1",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "undici": "latest",
    "ws": "^8.18.0",
    "zustand": "^5.0.15",
    "@llamaindex/core": "0.6.23",
    "@llamaindex/env": "0.1.31",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.0.1-rc.5",
    "@deepseek-ai/dsh-sdk-protocol": "0.0.1-rc.1",
    "@deepseek-ai/dsh-session": "0.0.1-rc.5",
    "@deepseek-ai/dsh-invariants": "0.0.1-rc.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "latest",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "jsqr": "^1.4.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@deepseek-ai/cordis-plugin-hmr": "1.0.16"
  }
}
