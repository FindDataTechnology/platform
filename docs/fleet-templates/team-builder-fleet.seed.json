  "i18n": {
    "en": {
      "name": "Builder Crew",
      "description": "The official Builder crew: a triage post plus four roles covering the four ways to build something — a standing team (Team Architect), a publishable template (Blueprint Architect), a reusable in-chat expert (Pack Author), and a customer-facing facade (Facade Builder). It is on the starter sequence but is not a domain team: installing it does not start any work — it wakes when you call it. Each role targets a Builder pack's published catalog agent; a role whose pack is not installed reports that plainly while the other three keep working. Drafts only: approval, casting, publishing and trials are the owner's.",
      "agents": {
        "tb-triage": {
          "name": "Triage"
        }
      }
    },
    "ja": {
      "name": "Builder 建隊隊",
      "description": "公式 Builder 建隊隊：ものづくりの四つの経路を実体化可能な四崗の隊に編成します——常駐チーム（チームアーキテクト）、公開可能なテンプレート（ブループリントコンストラクター）、会話内で使える専門家（エージェント作者）、対外向けの分身（分身工房）。starter 序列の一員ですが領域チームではありません：導入しても勝手に働かず、呼ばれたときに動きます。各崗は各 Builder パックが公開するカタログエージェントを指し、そのパックが未導入なら該当崗がその旨を明示し、残り三崗は通常通り動作します。草稿のみ：承認・鋳造・公開・試走は主人が行います。",
      "agents": {
        "tb-triage": {
          "name": "トリアージ"
        }
      }
    },
    "es": {
      "name": "Escuadrón Builder",
      "description": "El escuadrón oficial Builder: cuatro roles que cubren las cuatro formas de construir algo — un equipo permanente (Arquitecto de Equipos), una plantilla publicable (Constructor de Planos), un experto reutilizable en el chat (Autor de Agentes) y una fachada de cara al cliente (Fábrica de Facades). Está en la secuencia inicial pero no es un equipo de dominio: instalarlo no inicia ningún trabajo, se activa cuando lo llamas. Cada rol apunta al agente de catálogo publicado por su pack Builder; un rol cuyo pack no está instalado lo dice claramente mientras los otros tres siguen funcionando. Solo borradores: aprobación, fundición, publicación y pruebas son del propietario.",
      "agents": {
        "tb-triage": {
          "name": "Triaje"
        }
      }
    },
    "fr": {
      "name": "Équipe Builder",
      "description": "L'équipe officielle Builder : quatre rôles couvrant les quatre façons de construire quelque chose — une équipe permanente (Architecte d'Équipe), un modèle publiable (Constructeur de Blueprints), un expert réutilisable dans le chat (Auteur d'Agents) et une façade tournée client (Atelier de Facades). Elle figure dans la séquence de démarrage mais n'est pas une équipe métier : l'installer ne lance aucun travail, elle se réveille quand vous l'appelez. Chaque rôle cible l'agent de catalogue publié par son pack Builder ; un rôle dont le pack n'est pas installé le dit clairement pendant que les trois autres continuent de fonctionner. Brouillons uniquement : approbation, forge, publication et essais restent au propriétaire.",
      "agents": {
        "tb-triage": {
          "name": "Triage"
        }
      }
    }
  }
