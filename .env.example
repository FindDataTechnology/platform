# Copy this file to .env and fill in LLM_API_KEY. Everything else is optional —
# the server degrades gracefully and always starts. `npm start` runs a single
# child process (server.js); LLM routing is handled natively by dsh-llm
# (settings.yaml + .credentials.yaml hot-reload) and SaaS connectors by
# dsh-mcp-client, so there is no proxy or gateway to configure here.

# Self-hosted OpenAI-compatible gateway - the upstream LLM provider the
# dsh-llm adapter calls. Put YOUR key here. Without it, dsh-llm starts
# with no chat provider and the chat is non-functional (logged warning).
LLM_API_KEY=sk-your-key
LLM_BASE_URL=http://your-gateway:port

# Default chat model. Must be one of the model ids the Volces provider in
# dsh-profile.js declares (that declared list IS the model selector).
DEFAULT_MODEL=glm-5.2

# Document collection (LlamaIndex.TS + PageIndex) model. Defaults to the same
# family used for chat; override with DOCUMENTS_MODEL. Must be a model id
# registered on the configured provider above.
# DOCUMENTS_MODEL=deepseek-v4-pro-0813

# ── Optional login ────────────────────────────────────────────────────────────
# AUTH_MODE is unset/none for open access, forward_auth for trusted proxy
# headers, or logto for direct OIDC login. Logto needs LOGTO_ENDPOINT and
# LOGTO_APP_ID; confidential web deployments also need LOGTO_APP_SECRET.
# AUTH_MODE=logto
# PAAS_BASE_URL=https://paas.example.com
# SESSION_SECRET=replace-with-a-long-random-secret
# SESSION_TTL_HRS=24
# LOGTO_ENDPOINT=https://auth.example.com
# LOGTO_APP_ID=your-web-client-id
# LOGTO_APP_SECRET=your-web-client-secret
# LOGTO_CLIENT_TYPE=confidential
# LOGTO_END_SESSION=false
#
# Desktop uses a second Logto public client with PKCE and a fixed loopback
# callback. Register http://127.0.0.1:47600/auth/callback in Logto.
# DESKTOP_SERVER_PORT=47600
#
# forward_auth trusts X-Forwarded-Email / X-ForwardedGroups only when the app is
# reachable solely through that proxy. SSO_ENABLED adds an optional identity
# overlay in open mode; it is ignored by forward_auth and logto.
# AUTH_MODE=forward_auth
# AUTH_LOGIN_PATH=/oauth2/start
# AUTH_LOGOUT_PATH=/oauth2/sign_out
# SSO_ENABLED=true
#
# Which identity groups count as admin (comma-separated). Affects the admin
# gates (branding/catalog/model/LLM mutations, MCP manage) and which Settings
# sections the web shows. Under AUTH_MODE=logto the groups come from Logto
# organization memberships + organization-role short names, so name this after
# your Logto org role — e.g. a role literally named "platform-admin" when one
# Logto tenant serves several products and "admin" would clash. Unset = "admin".
# ADMIN_GROUPS=platform-admin

# ── Branding ──────────────────────────────────────────────────────────────────
# What this deployment calls its assistant. One value, several surfaces: the
# sidebar title, the label above every assistant turn, the composer
# placeholder, the built-in agent's row in the agent picker, and the browser
# tab title. Unset ⇒ the localized defaults ("Platform" / "Platform 助手" /
# "Platform Assistant" …). Served by GET /api/config, so changing it needs a
# restart but no rebuild.
# ASSISTANT_NAME=Platform 助手
#
# Deployment branding, four fields in total (see the four variables below).
# Resolution order for each: stored value (SQLite, editable in Settings →
# 部署品牌 by an admin, no restart) → env variable here → localized default
# (or absence, for icon/footer). A stored value always wins over env; clearing
# a stored value in the admin UI falls back to the env variable.
# COMPANY_NAME=寻数科技            # company name, interpolated into login-page copy
# ASSISTANT_NAME (above) also participates: it is the branding-store field the admin UI edits
# BRAND_ICON_URL=https://cdn.example/icon.png  # login-page brand icon + browser-tab favicon (http(s)://)
# LOGIN_FOOTER_TEXT=© 2026 寻数科技 # one-line footer under the login card; unset ⇒ no footer element

# ── Agent & app catalog (template: agents.example.json) ─────────────────────
# Local catalog = agents.json (sibling of mcp.json, gitignored). Cloud catalog
# = AGENTS_CONFIG_URL JSON, same schema; merged by id, cloud wins. Refreshed
# every CATALOG_REFRESH_SECS (and via POST /api/catalog/refresh). A cloud
# outage keeps the last-good entries. A chat-mode entry is served by the LOCAL
# agent with a generated persona preset (its name/description, or its explicit
# `persona` field) — so it keeps the platform's tools (MCP servers, skills) and
# conversation history; declare `"local": false` on an entry that really is a
# remote agent service (it keeps the OpenAI-compatible fork). See
# docs/vertical-packs.md §6. An entry of type
# "external-service" gets
# a token-injecting reverse proxy at /external/<id> — that is how a separately
# deployed web UI (your own LLM proxy dashboard, connector gateway, admin
# console) is embedded same-origin without its URL or token reaching the
# browser; the token is resolved server-side from the entry's apiKeyEnv.
# AGENTS_CONFIG_URL=https://example.com/agents.json
# CATALOG_REFRESH_SECS=60
# Server-side Nango secret for app entries of kind "nango-connect" (never sent
# to the browser).
# NANGO_SECRET_KEY=

# ── Registry-backed market (self-hosted mcp-gateway-registry) ────────────────
# Pulls MCP servers, skills (installed on demand), and agents from your
# registry into the extension market + agent catalog. Unset = bundled catalog
# only (default). REGISTRY_URL is accepted as a fallback for the URL.
# MARKET_REGISTRY_URL=https://mcp.example.com
# MARKET_REGISTRY_TOKEN=<service token — UI login JWT or M2M token; refresh it
#   when it expires: a rejected token keeps the last-good catalog and warns>
# Refresh cadence for the market snapshot (the agent catalog follows
# CATALOG_REFRESH_SECS). Group visibility comes from the optional local
# registry-groups.json ({servers:{name:[groups]},skills:{...},agents:{...}});
# entries absent from the mapping are visible to everyone.
# MARKET_REGISTRY_TTL_SECS=300
# Per-user connect flow (Store → 连接 MCP 市场): the registry routes the popup
# uses. Defaults match the upstream registry; override when a version moves
# them. The registry must ALSO CORS-allow this platform's origin with
# credentials and serve its session cookie SameSite=None; Secure — see
# the ops runbook ("Per-user market connect") for the prerequisite and a curl check.
# MARKET_REGISTRY_LOGIN_PATH=/login
# MARKET_REGISTRY_CSRF_PATH=/api/auth/csrf-token
# MARKET_REGISTRY_TOKENS_PATH=/api/tokens/generate

# ── Web search relay (operator-run service; the agent's web_search tool) ─────
# The bundled websearch MCP server ships enabled everywhere and calls ONE
# operator-run relay that pools search-provider keys (SerpAPI rotation + GLM
# fallback, cache, per-token daily caps). Customers never hold provider keys;
# this pair is all a deployment needs. Both vars or neither: unset ⇒ the
# web_search tool answers an explicit "not configured" error (web_read, the
# local page fetcher, keeps working regardless). See the ops runbook "Web search
# relay" for the contract the relay must implement.
# SEARCH_RELAY_URL=https://search-relay.example.com
# SEARCH_RELAY_TOKEN=<per-customer relay token>

# ── Bot relay (machine callers → chat-platform bots) ─────────────────────────
# Lets a machine caller on a trusted network deliver text through a bot channel
# an operator pre-bound: POST /api/bots/relay/send with this bearer token, no
# browser session. Unset (default) = the route answers 404, i.e. inert.
# The token must only travel over a network you trust — loopback/LAN as-is, or a
# TLS-terminated ingress you front yourself. Bind channels over the admin REST
# routes (/api/bots/chats lists the recorded chats, /api/bots/channels binds
# one); a channel is only bindable to a chat that has messaged the bot.
# BOTS_RELAY_TOKEN=<long random secret; rotate it like MARKET_REGISTRY_TOKEN>
# Per-bot turn timeout on chat platforms, ms (default 180000).
# BOTS_TURN_TIMEOUT_MS=180000
# Lift the answer-only posture for bot turns (tool use allowed). Off by default.
# BOTS_ALLOW_TOOLS=1

# ── Hosted cells (cloud deployment behind the gateway) ───────────────────────
# A "cell" is one server.js process serving exactly ONE user: its own data
# directory, its own agent home, its own port. Nothing here is needed for dev
# (`npm start`) or the desktop app — they run a single-cell deployment with
# these variables unset. The gateway's spawner sets all of them per user; this
# block is the contract it implements, and enough to start cells by hand.
#
# The per-user env matrix:
#   PLATFORM_DATA_DIR   <CELL_DATA_ROOT>/<user>/data   all writable app state
#   DSH_HOME            <CELL_DATA_ROOT>/<user>/dsh    agent home, settings, profile
#   MCP_CONFIG_PATH     <CELL_DATA_ROOT>/<user>/mcp.json
#   PORT                one free port per cell
#   HOST                127.0.0.1 — loopback only
#   AUTH_MODE           forward_auth (the gateway supplies identity)
#   CLOUD_MODE          1 — see below
#   CELL_GATEWAY_SECRET shared with the gateway
#   CELL_USER_EMAIL     the cell's user, so their saved model/MCP bindings
#                       apply at boot instead of on the first request
#
# CLOUD_MODE turns on the active identity-trust gate. Without it, forward_auth
# trusts X-Forwarded-Email/-Groups on the assumption that the server is
# reachable only through the proxy — an assumption that does not hold on a host
# where the gateway shares the machine with many cells. With it, identity
# headers count only when the same request carries CELL_GATEWAY_SECRET
# (constant-time compare); anything else is treated as having no identity at
# all. CLOUD_MODE is never set by hand in dev.
# CLOUD_MODE=1
# CELL_GATEWAY_SECRET=replace-with-a-long-random-secret
#
# DSH_SHARED_HOME is the deployment's installed dsh tree. A per-user DSH_HOME is
# scaffolded from dsh-profile-template/ and linked to this tree read-only, so
# cells share one installed bundle set instead of each installing their own.
# Defaults to ~/.dsh (the same as DSH_HOME), which is what dev and desktop use.
# DSH_SHARED_HOME=/opt/dsh-home
#
# AGENT_WORKSPACE pins the dsh runtime's working directory at boot
# (fix-agent-workspace). Precedence: this pin > the persisted current-workspace
# preference > the process working directory. The pin outranks the preference so
# a stale switch can never strand the deployment in an unwritable root. Must be
# absolute and WRITABLE — /api/files and the resource-library save key off the
# runtime cwd, so files written outside it are unservable. Unset (dev/desktop)
# keeps today's behavior exactly.
# AGENT_WORKSPACE=/data/workspace

# Task worker slots (worker-pool): on-demand persona-pinned runtimes that run
# task executions in parallel with the interactive chat. 0 = serial mode
# (exactly the pre-pool behavior; the safe default). Local/demo: 3.
# fd-prod: keep 0 until node capacity allows (4GB OOM history).
# TASK_WORKER_MAX=0

# Mission Control console bridge (mission-control-bridge): the cell registers
# as ONE console agent and runs console-dispatched tasks (title=<persona>,
# description=<prompt>). Off unless MC_BRIDGE=1. v1: operator/demo cells only.
# MC_BRIDGE=1
# MC_URL=http://<mission-console-host>:3333
# MC_API_KEY=
# MC_AGENT_NAME=my-operator-cell


#
# SESSION_LEGACY_OWNER (add-session-ownership) assigns every still-ownerless
# chat session to one account, once, at boot — for deployments upgrading across
# the ownership feature. Sessions record their owner from the first message's
# authenticated user; rows that predate that (or were created with auth off)
# carry NULL, and under auth-on a NULL row is admin-visible only. Set this to
# the account that owns today's sessions BEFORE enabling multi-user access;
# idempotent, so setting it later and restarting claims the remainder. Leave
# unset on auth-off deployments (single-user semantics keep everything visible).
# SESSION_LEGACY_OWNER=owner@yourdomain.com
#
# Two rules make a cell deployment safe:
#   1. Bind loopback only (HOST=127.0.0.1) and never expose a cell port. The
#      gateway is the only reachable surface; the secret above is
#      defence-in-depth for the shared-host case, not a substitute for this.
#   2. Cell data directories must sit on LOCAL disk. Every store is
#      better-sqlite3 + WAL, and SQLite over NFS corrupts.
#
# Starting two cells by hand (each writes only under its own root):
#   PORT=3101 HOST=127.0.0.1 AUTH_MODE=forward_auth \
#     PLATFORM_DATA_DIR=/data/alice/data DSH_HOME=/data/alice/dsh \
#     MCP_CONFIG_PATH=/data/alice/mcp.json \
#     CLOUD_MODE=1 CELL_GATEWAY_SECRET=$SECRET node server.js
#   # …and the same for bob on port 3102 with /data/bob, then reach each one
#   # through the gateway (or directly with the identity headers + secret).
#
# ── WeChat mini program (gateway OR single-process AUTH_MODE=logto) ─────────
# Enables the mini-program identity path (openspec: miniprogram-auth):
# account binding with bind codes. First launch binds the WeChat openid to
# the user's Logto account (6-digit code from /api/mp/bindcode in a signed-in
# browser); every later launch is a silent wx.login → /api/mp/login →
# platform JWT (Bearer) carrying the ACCOUNT email/groups, so the mini
# program lands on the same data as the browser. Works on both deployment
# shapes — the gateway and the single-process server (bindings live at
# <CELL_DATA_ROOT>/mp-bindings.json or data/mp-bindings.json respectively).
# All of MP_APPID / MP_SECRET / MP_TOKEN_SECRET must be set to enable it;
# with any unset, the login routes report "not configured" and nothing else
# changes. MP_SECRET never leaves the server process. MP_TOKEN_SECRET must be
# its own random value — separate from CELL_GATEWAY_SECRET/SESSION_SECRET on
# purpose, so leaking one cannot forge the other.
# MP_APPID=wx1234567890abcdef
# MP_SECRET=replace-with-the-miniprogram-appsecret
# MP_TOKEN_SECRET=replace-with-a-long-random-secret
# MP_TOKEN_TTL_HOURS=12
# MP_JS_CODE_URL=https://api.weixin.qq.com/sns/jscode2session   # test seam only
#
# ── Mini-program demo mode (openspec: mp-demo-mode; GATEWAY only) ────────────
# With MP_DEMO_MODE on, an unbound openid gets a demo identity
# (demo-<hash>@demo.invalid, group "demo") instead of binding_required — the
# WeChat reviewer path: open, chat, zero popups. Demo users land in their own
# bounded cells: at most MP_DEMO_MAX_CELLS running at once (a friendly busy
# reply beyond), reaped MP_DEMO_IDLE_SECS after going idle (data directory
# deleted), and each demo cell answers at most MP_DEMO_MSG_LIMIT prompts with
# a bind-your-account invitation beyond. Account cells are unaffected (still
# resident, still persistent). Ignored on the single-process server on
# purpose: one shared runtime would expose the owner's data to anonymous
# WeChat users.
# MP_DEMO_MODE=0
# MP_DEMO_MAX_CELLS=3
# MP_DEMO_IDLE_SECS=900
# MP_DEMO_MSG_LIMIT=20
#
# ── Demo SANDBOX (openspec: mp-demo-sandbox; dedicated accountless pod) ──────
# DEMO_SANDBOX=true turns a single-process deployment into the accountless
# reviewer sandbox: every WS connection gets its own MP_DEMO_MSG_LIMIT prompt
# budget, document uploads are rejected (403), and chat sessions are wiped
# every DEMO_SANDBOX_WIPE_SECS (start a fresh session, delete the rest; never
# mid-turn). Intended for the dedicated platform-demo pod only — NEVER set on
# a deployment holding real accounts or data (it serves anonymous users).
# DEMO_SANDBOX=false
# DEMO_SANDBOX_WIPE_SECS=7200
#
# ── Agent serving (openspec: add-a2a-agent-serving; deploy side) ────────────
# The marketplace's "deploy as service" action pushes pack skills + one a2a
# agent entry to the registry. AGENT_SERVING_RUNNER_URL is the runner's
# backend origin (registry reverse-proxies /agent/{path}/ onto it) and is
# REQUIRED for the deploy route to answer anything but 503.
# AGENT_SERVING_REGISTRY_URL / _TOKEN fall back to REGISTRY_URL /
# MARKET_REGISTRY_TOKEN when unset (single-process deployments share them).
# AGENT_SERVING_RUNNER_URL=http://runner.tailnet:8790/a
# AGENT_SERVING_REGISTRY_URL=https://mcp.finddatatech.cloud
# AGENT_SERVING_REGISTRY_TOKEN=
# Skill entries pushed at deploy land group-visible to these registry groups:
# AGENT_SERVING_SKILL_GROUPS=pack-deployers
