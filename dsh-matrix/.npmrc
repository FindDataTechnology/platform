# No legacy-peer-deps here, deliberately (design D3): npm's default peer
# auto-install resolves the full peer-only closure (the 18 dsh-* plugins that
# dsh-base reaches only via peerDependencies) once at lock-generation time,
# and package-lock.json freezes the result. The Dockerfile's historical
# legacy-peer-deps=true is what forced 18 hand-written pins to exist.
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
